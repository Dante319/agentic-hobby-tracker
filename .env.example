# Copy this to .env and fill in your values
# Never commit .env to git

# Required
OPENAI_API_KEY=sk-...

# Optional — swap to Claude if preferred
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...

# External APIs (get free keys at the links below)
TMDB_API_KEY=           # themoviedb.org/settings/api
IGDB_CLIENT_ID=         # dev.twitch.tv/console/apps
IGDB_CLIENT_SECRET=

# Your Letterboxd public username
LETTERBOXD_USERNAME=

# Path to your Goodreads export CSV
GOODREADS_CSV_PATH=./data/goodreads_library_export.csv

# Leave blank to use defaults (SQLite + local Chroma)
# DATABASE_URL=postgresql://user:pass@localhost/hobby_tracker
# CHROMA_PERSIST_DIR=./db/chroma
